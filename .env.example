# Copie para .env e preencha. .env nunca vai para o git.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/retorno?sslmode=require"

# Senha única de acesso
APP_PASSWORD=""

# Chave que assina o cookie de sessão. Trocar este valor derruba todas as
# sessões abertas — é o botão de "sair de todos os aparelhos".
# Gerar com:  openssl rand -base64 32
APP_SESSION_SECRET=""

# Só em produção — o resumo diário das 7h (Vercel Cron + Resend)
CRON_SECRET=""
RESEND_API_KEY=""
EMAIL_RESUMO=""
EMAIL_REMETENTE="Retorno <onboarding@resend.dev>"
APP_URL="https://retorno.vercel.app"

# Google Calendar Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""


